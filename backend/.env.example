ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=info

SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=sqlite:///./mamacare-ai.db
# PostgreSQL example:
# DATABASE_URL=postgresql://username:password@localhost:5432/mamacare_ai

CORS_ORIGINS=https://your-frontend-domain.com
ALLOWED_HOSTS=localhost,127.0.0.1,*.onrender.com,*.vercel.app,*.netlify.app
FRONTEND_URL=https://your-frontend-domain.com

MODEL_PATH=/app/ai-development/ml-model/models/best_model_hackathon_gradient_boosting.pkl
LABEL_ENCODER_PATH=/app/ai-development/ml-model/models/label_encoder_hackathon.pkl
FEATURE_NAMES_PATH=/app/ai-development/ml-model/models/feature_names_hackathon.pkl
SCALER_PATH=/app/ai-development/ml-model/models/scaler_hackathon.pkl

GOOGLE_APPLICATION_CREDENTIALS=/app/secrets/google-service-account.json

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
EMAIL_ENABLED=false

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=
